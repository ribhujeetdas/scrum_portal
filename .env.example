# Runtime identity. Production mode refuses weak or incomplete security settings.
APP_ENV=production
APPLICATION_VERSION=local
SECRET_KEY=replace-with-at-least-32-random-bytes
FERNET_KEY=replace-with-a-generated-fernet-key
ADMIN_EMAIL=admin@example.com

# SQLite only. Relative paths are stored under Flask's instance directory.
DATABASE_URL=sqlite:///app.db
SQLITE_CONNECT_TIMEOUT_SECONDS=30
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_SYNCHRONOUS=FULL
# DELETE is the safe cross-platform default. WAL is rejected on vulnerable SQLite builds.
SQLITE_JOURNAL_MODE=DELETE
SQLITE_WRITE_RETRY_TOTAL=2
SQLITE_WRITE_RETRY_BACKOFF_SECONDS=0.05
DATABASE_INSTANCE_LOCK=true
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION=14
MIN_FREE_DISK_MB=256

# Session and browser security. Set Secure=true only when the app is actually served over HTTPS.
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_MAX_MINUTES=480
SESSION_WARNING_THRESHOLD_RATIO=0.8
SIGNUP_STATE_TTL_MINUTES=20
WTF_CSRF_TIME_LIMIT_SECONDS=3600
MAX_CONTENT_LENGTH_BYTES=2097152

# Jira Data Center.
JIRA_BASE_URL=https://jira.example.com
JIRA_AUTOMATION_ACTOR_ACCOUNT_ID=JIRAUSER_SERVICE_ACCOUNT
JIRA_PAT_VALIDATION_CACHE_SECONDS=300

# Tableau Server.
TABLEAU_BASE_URL=https://tableau.example.com
TABLEAU_API_VERSION=3.25
TABLEAU_SITE_CONTENT_URL=

# Outbound reliability and capacity controls.
EXTERNAL_HTTP_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_HTTP_TIMEOUT_SECONDS=20
EXTERNAL_HTTP_RETRY_TOTAL=3
EXTERNAL_HTTP_RETRY_BACKOFF_SECONDS=0.5
EXTERNAL_HTTP_RETRY_STATUS_CODES=429,500,502,503,504
EXTERNAL_HTTP_MAX_CONCURRENT=12
EXTERNAL_HTTP_BULKHEAD_WAIT_SECONDS=1.0
EXTERNAL_HTTP_CIRCUIT_FAILURE_THRESHOLD=5
EXTERNAL_HTTP_CIRCUIT_RESET_SECONDS=30
EXTERNAL_OPERATION_MAX_PAGES=100
EXTERNAL_OPERATION_DEADLINE_SECONDS=120

# Per-process rate limits. The supported deployment topology is one Waitress process.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=8
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_EXPENSIVE_ATTEMPTS=20
RATE_LIMIT_EXPENSIVE_WINDOW_SECONDS=60

# Waitress production server.
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=5000
WAITRESS_THREADS=4
WAITRESS_CONNECTION_LIMIT=100
WAITRESS_CHANNEL_TIMEOUT_SECONDS=120

# Structured application and audit logs.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_BACKUPS=14
AUDIT_LOG_FILE=audit.log
AUDIT_LOG_BACKUPS=30
LOG_TO_CONSOLE=false
LOG_TIMEZONE=Asia/Kolkata
LOG_FORMAT=json
LOG_WERKZEUG_LEVEL=WARNING
LOG_URLLIB3_LEVEL=WARNING
LOG_SQLALCHEMY_LEVEL=WARNING

# Durable Sprint metric jobs. Queued mode keeps slow Jira work off Waitress threads.
SPRINT_METRICS_MODE=queued
SPRINT_METRICS_GLOBAL_WORKERS=2
SPRINT_METRICS_CONNECT_TIMEOUT_SECONDS=5
SPRINT_METRICS_READ_TIMEOUT_SECONDS=45
SPRINT_METRICS_CONNECT_RETRIES=1
SPRINT_METRICS_READ_RETRIES=0
SPRINT_METRICS_STATUS_RETRIES=1
SPRINT_METRICS_JOB_DEADLINE_SECONDS=180
SPRINT_METRICS_CACHE_TTL_SECONDS=86400
SPRINT_METRICS_RUN_RETENTION_DAYS=30
SPRINT_METRICS_MAX_ATTEMPTS=2
# Temporary rollback settings used only when SPRINT_METRICS_MODE=legacy.
SPRINT_METRICS_MAX_WORKERS=3
SPRINT_METRICS_HTTP_TIMEOUT_SECONDS=20

# Compatibility route retirement headers.
LEGACY_ROUTE_DEPRECATION_HEADERS=true
LEGACY_ROUTE_SUNSET=

# Keep verbose traces disabled except during a time-boxed investigation.
TRACE_SPRINT_VIEWER=false
TRACE_JIRA_JQL=false
TRACE_SPRINT_VIEWER_API=false
TRACE_SPRINT_VIEWER_UI=false
