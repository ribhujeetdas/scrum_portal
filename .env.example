# Flask
APP_ENV=development
SECRET_KEY=change-me-at-least-32-random-characters
# Production requires an absolute local path, for example sqlite:///D:/ScrumPortal/data/portal.db
DATABASE_URL=sqlite:///app.db
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=0

# Jira Data Center base URL (no trailing slash)
JIRA_BASE_URL=https://jira.example.com
JIRA_ENABLED=true
JIRA_SOURCE_ID=primary-jira
JIRA_STORY_POINTS_FIELD=customfield_10106
JIRA_APPLICATION_FIELD=customfield_11700
JIRA_EPIC_LINK_FIELD=customfield_10100
JIRA_HISTORY_VISIBILITY_FOLLOWS_ISSUE=false
JIRA_AUTOMATION_ACTOR_ACCOUNT_ID=JIRAUSER_SERVICE_ACCOUNT
JIRA_PAT_VALIDATION_CACHE_SECONDS=300

# Admin email shown for forgot password
ADMIN_EMAIL=admin@example.com

# Encryption key for PAT storage
# Generate with:
#   py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generated-fernet-key

# Security cookie flags
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Session timeout
SESSION_TIMEOUT_MINUTES=15
SESSION_WARNING_THRESHOLD_RATIO=0.8

# Tableau
TABLEAU_ENABLED=true
TABLEAU_BASE_URL=https://tableau.example.com
TABLEAU_API_VERSION=3.25
TABLEAU_SITE_CONTENT_URL=

# Structured logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_BACKUPS=14
LOG_TO_CONSOLE=false
LOG_TIMEZONE=Asia/Kolkata
LOG_FORMAT=json
LOG_WERKZEUG_LEVEL=WARNING
LOG_URLLIB3_LEVEL=WARNING
LOG_SQLALCHEMY_LEVEL=WARNING

# Diagnostic tracing. Keep false in production unless actively debugging.
TRACE_SPRINT_VIEWER=false
TRACE_JIRA_JQL=false
TRACE_SPRINT_VIEWER_API=false
TRACE_SPRINT_VIEWER_UI=false

# External Jira/Tableau HTTP retry behavior.
EXTERNAL_HTTP_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=20
HTTP_OPERATION_BUDGET_SECONDS=60
HTTP_RETRY_AFTER_MAX_SECONDS=30
HTTP_MAX_JSON_BYTES=16777216
TABLEAU_MAX_CSV_BYTES=33554432
EXTERNAL_HTTP_RETRY_TOTAL=2
EXTERNAL_HTTP_RETRY_BACKOFF_SECONDS=0.5
EXTERNAL_HTTP_RETRY_STATUS_CODES=429,500,502,503,504
EXTERNAL_CA_BUNDLE=
EXTERNAL_TRUST_ENV=true

# Legacy route retirement headers.
LEGACY_ROUTE_DEPRECATION_HEADERS=true
LEGACY_ROUTE_SUNSET=

# Durable Sprint Viewer. Use direct during rollout and snapshot after the worker is healthy.
SPRINT_VIEWER_MODE=direct
SPRINT_VIEWER_SNAPSHOT_USER_IDS=
SPRINT_SNAPSHOT_ACCESS_POLICY=jira_revalidate
SPRINT_JOB_LEASE_SECONDS=120
SPRINT_JOB_HEARTBEAT_SECONDS=15
SPRINT_JOB_MAX_ATTEMPTS=3
SPRINT_JOB_POLL_SECONDS=1
SPRINT_WORKER_STALE_SECONDS=60
SPRINT_COMPONENT_MAX_RUNTIME_SECONDS=1800
JIRA_MAX_INFLIGHT_PER_SOURCE=4
JIRA_MAX_BACKGROUND_INFLIGHT=2
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WRITE_BUDGET_SECONDS=5
RATE_LIMITS_ENABLED=true
