APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-a-valid-fernet-key
DATABASE_URL=sqlite:///D:/ScrumPortal/data/portal.db
TRUSTED_HOSTS=scrum.example.internal
TRUSTED_PROXY_COUNT=1
SESSION_COOKIE_SECURE=true
REMEMBER_COOKIE_SECURE=true

JIRA_ENABLED=true
JIRA_BASE_URL=https://jira.example.internal
JIRA_SOURCE_ID=primary-jira
JIRA_AUTOMATION_ACTOR_ACCOUNT_ID=replace-with-service-account
TABLEAU_ENABLED=true
TABLEAU_BASE_URL=https://tableau.example.internal
TABLEAU_API_VERSION=3.25

SPRINT_VIEWER_MODE=snapshot
SPRINT_SNAPSHOT_ACCESS_POLICY=jira_revalidate
SPRINT_JOB_LEASE_SECONDS=120
SPRINT_JOB_HEARTBEAT_SECONDS=15
SPRINT_WORKER_STALE_SECONDS=60
JIRA_MAX_INFLIGHT_PER_SOURCE=4
JIRA_MAX_BACKGROUND_INFLIGHT=2
JIRA_HISTORY_VISIBILITY_FOLLOWS_ISSUE=false
TABLEAU_MAX_CSV_BYTES=33554432
EXTERNAL_CA_BUNDLE=
EXTERNAL_TRUST_ENV=true
SQLITE_BUSY_TIMEOUT_MS=5000
RATE_LIMITS_ENABLED=true

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
TRACE_SPRINT_VIEWER=false
TRACE_JIRA_JQL=false
